#!/usr/bin/env bash
set -e

# OpenMimi launcher for Unix/macOS
# Works from any directory — auto-detects venv or system Python

DIR="$(cd "$(dirname "$0")" && pwd)"

if [ -f "$DIR/.venv/bin/python" ]; then
    PYTHON_CMD="$DIR/.venv/bin/python"
elif [ -f "$DIR/venv/bin/python" ]; then
    PYTHON_CMD="$DIR/venv/bin/python"
else
    PYTHON_CMD="python3"
fi

exec "$PYTHON_CMD" -m openmimi "$@"
