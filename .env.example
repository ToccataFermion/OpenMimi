ANTHROPIC_API_KEY=sk-ant-...

# Optional: point at an Anthropic-compatible proxy (e.g. Aliyun MaaS)
# When set, prompt caching is auto-disabled because most third-party
# endpoints don't recognise the cache_control field.
# ANTHROPIC_BASE_URL=https://your-proxy.example.com/anthropic
# ANTHROPIC_MODEL=qwen3.6-plus

OPENMIMI_LOG_LEVEL=INFO
